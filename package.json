{
  "name": "kgbot",
  "version": "1.0.0",
  "description": "Killing game bot by vagueposting.",
  "homepage": "https://github.com/vagueposting/kgbot#readme",
  "bugs": {
    "url": "https://github.com/vagueposting/kgbot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vagueposting/kgbot.git"
  },
  "license": "MIT",
  "author": "vagueposting",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "echo 'Bypassing prebuild script...'",
    "type-check": "tsc --noEmit",
    "build": "npm run type-check && npx esbuild \"src/**/*.ts\" --bundle --minify --platform=node --external:better-sqlite3 --outdir=dist",
    "refresh": "bash ./refresh.sh"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@ohm-js/cli": "^2.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "ssh2-sftp-client": "^12.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "esbuild": "^0.28.2",
    "discord.js": "latest",
    "dotenv": "latest",
    "ohm-js": "^17.5.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "cpu-features": true,
    "ssh2": true,
    "esbuild": true
  }
}