{
  "name": "kgbot",
  "version": "1.0.0",
  "description": "Killing game bot by vagueposting.",
  "homepage": "https://github.com/vagueposting/kgbot#readme",
  "bugs": {
    "url": "https://github.com/vagueposting/kgbot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vagueposting/kgbot.git"
  },
  "license": "MIT",
  "author": "vagueposting",
  "main": "dist/index.js",
  "scripts": {
    "build:ohm": "npx ohm generateBundles -t 'src/utils/response_generator/*.ohm'",
    "copy:assets": "cpy \"src/utils/response_generator/*.js\" dist/utils/response_generator",
    "build": "npm run build:ohm && npx tsc && npm run copy:assets",
    "refresh": "bash ./refresh.sh"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cpy-cli": "^7.0.0"
  },
  "devDependencies": {
    "@ohm-js/cli": "^2.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "discord.js": "latest",
    "dotenv": "latest",
    "ohm-js": "^17.5.0",
    "ssh2-sftp-client": "^12.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "cpu-features": true,
    "ssh2": true,
    "esbuild": true
  }
}