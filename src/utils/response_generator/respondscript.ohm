RespondScript {
  Program = StateDeclaration* Default Statement*

  Default = Display
 
  Statement = MethodDeclaration 
            | ConditionalBlock
            | RollDeclaration
            | Display
  
 // instead of assigning values, the State Declaration checks 
 // which parts of the object state are actually relevant
  StateDeclaration = ObjectState | PlayerState
  
  ObjectState = "{{#" listOf<Identifier, ","> "}}"
  PlayerState = "{{P" PlayerStuff "}}"
  PlayerStuff = "pockets" | "thoughts" // TODO: add more. but i'll get there as i design.
 
  MethodDeclaration = "{{&" MethodBody "}}"
  MethodBody = ObjectMethod | PlayerMethod
	ObjectMethod =  Identifier (ActionType Identifier ActionDegree?)* 
  PlayerMethod = PlayerStuff MetaCode
  MetaCode = (letter alnum)*
  
  ConditionalBlock = IfClause ElseIfClause* ElseClause? "{{/?}}"
  IfClause         = "{{?" Condition "}}" Statement*
  ElseIfClause     = "{{??" Condition "}}" Statement*
  ElseClause       = "{{!?" "}}" Statement*

  AliasBlock = "{{alias}}" AliasCase+ ElseClause? "{{/alias}}"
  AliasCase  = "{{:" listOf<StringLiteral, ","> "}}" Statement*

  Condition        = Identifier Comparator Value
  Comparator       = "==" | "!=" | ">=" | "<=" | ">" | "<"
  
  EmbedState = "{{" IdentifierOperation "}}"
  
  IdentifierOperation = Identifier (Operand RightHandSide)?
  RightHandSide = Identifier | NumberLiteral
  Operand = "+" | "-" | "*" | "/"
  
  RollDeclaration = "{{@" NumberLiteral "|" listOf<Approach, ",">? "|" listOf<Skill, ",">? "}}" (FlavorVariant? RollSucceed RollFail?)* "{{/@}}"
  
  FlavorVariant = "{{>" Approach? "|"? Skill? "}}" // you can get an approach or a skill, or both!
  RollSucceed = "{{=succeed}}" Statement*
  RollFail = "{{=fail}}" Statement*
  
  Approach = caseInsensitive<"Careful"> 
           | caseInsensitive<"Clever"> 
           | caseInsensitive<"Flashy"> 
           | caseInsensitive<"Forceful"> 
           | caseInsensitive<"Quick"> 
           | caseInsensitive<"Sneaky"> 
           
  Skill = caseInsensitive<"Homemaking">
        | caseInsensitive<"Sustainment">
        | caseInsensitive<"Skulduggery">
        | caseInsensitive<"Scholarship">
        | caseInsensitive<"Athletics">
        | caseInsensitive<"Interfacing">
        | caseInsensitive<"Composure">
        | caseInsensitive<"Esthesia">
        | caseInsensitive<"Instinct">
        | caseInsensitive<"Dominion">
  
  Display = EmbedState | PlainText
  
  PlainText = (~"{{" any)+
 
  Identifier = ~Keyword name
  name = letter alnum*
  
  Keyword = ActionType | BooleanLiteral | "succeed" | "fail"

  Value = StringLiteral | NumberLiteral | BooleanLiteral
  StringLiteral = alnum+
  NumberLiteral = digit+
  BooleanLiteral = "true" | "false"

  ActionType = "dec" | "inc" | "set"
             | "flip" | "true" | "untrue"
                        
  ActionDegree = QuotedString | NumberLiteral
  QuotedString = "\"" alnum* "\""
  
  space := "\x00".."\x20"
}