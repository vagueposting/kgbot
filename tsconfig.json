{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/**/*",
    "tools/deploy-sftp.ts",
    "tools/wipe-commands.ts",
    "tools/deploy-commands.ts"
  ],
  "exclude": ["node_modules"]
}
